# Copiar a `.env` y ajustar. Ningún valor de este archivo es secreto.

# Base de datos. SQLite para el prototipo; en producción, por ejemplo:
#   DATABASE_URL=postgresql+psycopg://bienes:clave@db.interno:5432/bienes
DATABASE_URL=sqlite:///./bienes.db

# Orígenes autorizados para CORS, separados por coma (sin barra final).
CORS_ORIGINS=http://localhost:5173,https://mrenedelacruz-bit.github.io

# Dominio público de la PWA. Es la base de las URLs que se graban en las
# etiquetas NFC: {PUBLIC_BASE_URL}/activo/{ncf}
PUBLIC_BASE_URL=https://mrenedelacruz-bit.github.io/ruteo

# Sembrar datos de ejemplo al arrancar si la base está vacía.
SEED_ON_STARTUP=true
