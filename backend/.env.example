DATABASE_URL=postgresql+psycopg://ruteo:ruteo@localhost:5432/ruteo

# Geocodificacion de direcciones (Nominatim). Cambiar el User-Agent por uno
# propio identificable segun la politica de uso de Nominatim.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODE_USER_AGENT=ruteo-app
GEOCODE_COUNTRY_CODES=do

# Motor de distancias viales OSRM. Dejar vacio (OSRM_BASE_URL=) para usar
# siempre distancia en linea recta (haversine). Para produccion se recomienda
# una instancia propia de OSRM con mapas de Republica Dominicana.
OSRM_BASE_URL=https://router.project-osrm.org

# Autenticacion. OBLIGATORIO poner un secreto largo y aleatorio en produccion.
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRE_MINUTES=480
